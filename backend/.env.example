# Set APP_ENV=production when deployed. Production fails closed without Redis and API key.
APP_ENV=development
INFRACIS_API_KEY=replace-with-a-long-random-server-only-secret
REDIS_URL=redis://localhost:6379/0

# Request and provider safety limits
REQUEST_TIMEOUT_SECONDS=10
RATE_LIMIT_ANALYZE_PER_MINUTE=12
NOMINATIM_MIN_INTERVAL_SECONDS=1.0
OVERPASS_RADIUS_METERS=1200

# Public provider endpoints (change only after reviewing provider policies/terms)
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
OPEN_METEO_BASE_URL=https://api.open-meteo.com
OPEN_METEO_AIR_QUALITY_BASE_URL=https://air-quality-api.open-meteo.com
OVERPASS_URL=https://overpass-api.de/api/interpreter
