# Optional Groq AI narrative. Keep this key server-side; never use NEXT_PUBLIC_GROQ_API_KEY.
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-20b

# Supabase server-side configuration; configure only after creating a project.
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Overpass uses a bounded public-instance failover for low-volume evaluation by default.
# Public instances are best-effort, may be rate-limited, and have no product SLA.
# For production, choose a provider whose terms and capacity fit your use; the public fallback failed
# the 2026-10-29 Delhi NCR pilot (0/18 valid amenity responses), so do not rely on it as verified.
# One hosted option is Overpass.ch, which issues an API key and documents quotas/errors at
# https://overpass.ch/docs. Keep its key in this server-only variable (never NEXT_PUBLIC_*):
# OVERPASS_API_URL=https://api.overpass.ch/v1/<SERVER_SIDE_API_KEY>/interpreter
# Up to three HTTPS endpoints can be tried sequentially; 429/406 stops retries to respect backoff.
# OVERPASS_API_URL=https://your-verified-overpass.example/api/interpreter
# Or provide a bounded failover list separated by commas or semicolons:
# OVERPASS_API_URLS=https://primary.example/api/interpreter;https://secondary.example/api/interpreter

# Location provider configuration. Do not expose secret keys in NEXT_PUBLIC_* variables.
# GEOCODING_PROVIDER=
# GEOCODING_API_KEY=

# Required for production API access: dedicated shared Redis store for rate limiting,
# Nominatim global request pacing, and provider response caching.
# In production, analyze/compare return 503 if these are absent or unreachable.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
