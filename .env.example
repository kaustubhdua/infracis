# Optional AI provider. Keep all secrets server-side.
# AI_PROVIDER=
# AI_API_KEY=

# Supabase server-side configuration; configure only after creating a project.
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Overpass public endpoints are best-effort and the pilot did not verify a reliable instance.
# Production must set OVERPASS_API_URL to a verified HTTPS endpoint before amenity data can be available.
# OVERPASS_API_URL=https://overpass-api.de/api/interpreter

# Location provider configuration. Do not expose secret keys in NEXT_PUBLIC_* variables.
# GEOCODING_PROVIDER=
# GEOCODING_API_KEY=

# Required for production API access: dedicated shared Redis store for rate limiting,
# Nominatim global request pacing, and provider response caching.
# In production, analyze/compare return 503 if these are absent or unreachable.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
